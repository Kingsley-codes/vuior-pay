# Firebase configuration for vuior-pay.
# Merge these into .env.local locally and your Vercel environment settings.
# Keep existing payment, maps, authentication, and other unrelated variables.
# All NEXT_PUBLIC values are public and included in the browser bundle.
# Copy Firebase web app config from Project settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ID=
# Optional analytics measurement ID.
NEXT_PUBLIC_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# NEW: required to enable browser push. This is NOT the sender ID or API key.
# Firebase Console > Project settings > Cloud Messaging > Web Push certificates
# Click Generate key pair and copy the PUBLIC key shown under Key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Redeploy/rebuild the web app after changing NEXT_PUBLIC values.
# Never put Firebase Admin private keys or an FCM server key here.
# See PUSH_NOTIFICATIONS.md for backend deployment and acceptance checks.
